{
  "schema_version": 1,
  "workflow_id": "alert-management-rebuild",
  "name": "报警管理系统产品化交付工作流",
  "prompt_train": {
    "start_goal": "automation/prompts/start-goal.md",
    "controller": "automation/prompts/controller.md",
    "stage_worker": "automation/prompts/stage-worker.md",
    "reviewer": "automation/prompts/reviewer.md"
  },
  "global_references": [
    "AGENTS.md",
    "CONTRIBUTING.md",
    "docs/product/README.md",
    "docs/product/requirements.md",
    "docs/product/data-contract.md",
    "docs/architecture/README.md",
    "docs/planning/README.md",
    "docs/planning/agent-collaboration.md",
    "docs/verification/README.md",
    "docs/automation/README.md",
    "docs/automation/state-machine.md",
    "docs/automation/git-workflow.md",
    "docs/verification/automation-audit.md",
    "docs/planning/productization-blueprint.md",
    "docs/product/source-coverage.md",
    "docs/algorithm/model-v2.md",
    "docs/security/threat-model.md",
    "docs/product/security-contract.md",
    "docs/releases/versioning.md"
  ],
  "stages": [
    {
      "id": "M0",
      "name": "来源提取与产品事实冻结",
      "depends_on": [],
      "references": [
        "docs/backgrounds/README.md",
        "docs/sources/README.md",
        "docs/sources/manifest.json",
        "docs/decisions/README.md"
      ],
      "acceptance": {
        "criteria": [
          "四份来源均有可追溯去向，排除内容和理由已记录",
          "P0 需求、数据契约、架构和验收入口含义唯一",
          "仓库结构、文档链接和提取可重复性检查通过"
        ],
        "commands": [
          "python3 scripts/validate_repository.py",
          "npm --prefix tools/document-extraction run check"
        ]
      }
    },
    {
      "id": "M1",
      "name": "可运行工程骨架",
      "depends_on": ["M0"],
      "references": [
        "src/README.md",
        "docs/architecture/README.md"
      ],
      "acceptance": {
        "criteria": [
          "Java、Python、Vue 和 PostgreSQL 可按开发说明启动",
          "浏览器显示灾后重建标识及数据库、算法、主系统健康状态",
          "基础编译、单元测试、静态检查和迁移重启检查通过"
        ],
        "commands": [
          "scripts/dev/test.sh",
          "scripts/dev/restart-smoke.sh"
        ]
      }
    },
    {
      "id": "M2",
      "name": "合成数据与导入闭环",
      "depends_on": ["M1"],
      "references": [
        "docs/product/data-contract.md",
        "docs/verification/README.md"
      ],
      "acceptance": {
        "criteria": [
          "CSV、制表符 TXT、XLSX 等价样例得到相同规范化结果",
          "非法样例产生逐项中文错误且没有半批次数据",
          "固定种子的 20000 行演示集可在目标电脑完成导入"
        ],
        "commands": [
          "scripts/dev/test.sh",
          "scripts/dev/m2-import-smoke.sh"
        ]
      }
    },
    {
      "id": "M3",
      "name": "算法与分析闭环",
      "depends_on": ["M2"],
      "references": [
        "docs/product/data-contract.md",
        "docs/verification/README.md"
      ],
      "acceptance": {
        "criteria": [
          "固定输入的规则结果和关联事件链可重复并符合独立预期",
          "Java 校验算法契约并原子保存结果",
          "算法不可用或响应非法时明确失败且不产生部分结果"
        ],
        "commands": [
          "scripts/dev/test.sh",
          "scripts/dev/m3-analysis-smoke.sh"
        ]
      }
    },
    {
      "id": "M4",
      "name": "前端业务闭环",
      "depends_on": ["M3"],
      "references": [
        "docs/product/requirements.md",
        "docs/verification/README.md"
      ],
      "acceptance": {
        "criteria": [
          "浏览器完成导入、分析、查看、事件链和人工处置主流程",
          "固定抽样的看板数字与 API 或数据库查询一致",
          "失败和空状态均有可行动的中文提示"
        ],
        "commands": [
          "scripts/dev/test.sh",
          "scripts/dev/m4-browser-smoke.sh"
        ]
      }
    },
    {
      "id": "M5",
      "name": "报告、审计和演示复位",
      "depends_on": ["M4"],
      "references": [
        "docs/product/requirements.md",
        "docs/verification/README.md"
      ],
      "acceptance": {
        "criteria": [
          "PDF 和 XLSX 可打开且关键数字与事实源一致",
          "导入、分析、修订、处置和导出审计字段完整",
          "演示数据连续复位两次后结果一致且不影响项目外数据"
        ],
        "commands": [
          "scripts/dev/test.sh",
          "scripts/dev/m5-report-audit-reset-smoke.sh"
        ]
      }
    },
    {
      "id": "M6",
      "name": "Windows 11 x64 原生发布与验收",
      "depends_on": ["M5"],
      "references": [
        "docs/architecture/README.md",
        "docs/verification/README.md",
        "docs/verification/automation-audit.md"
      ],
      "acceptance": {
        "criteria": [
          "新解压的自包含发布包无需预装 JDK、Python 或 Node 即可运行",
          "预检、启动、停止、备份和复位脚本作用域正确且失败不假成功",
          "两轮完整彩排通过且阻断、严重缺陷为零"
        ],
        "commands": [
          "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/native/verify-release.ps1"
        ]
      }
    },
    {
      "id": "M7",
      "name": "Docker Compose 次级交付",
      "depends_on": ["M6"],
      "references": [
        "docs/architecture/README.md",
        "docs/verification/README.md"
      ],
      "acceptance": {
        "criteria": [
          "Compose 从空项目卷健康启动",
          "复用原生方案的迁移、配置、样例和冒烟测试",
          "固定样例摘要与原生运行结果一致"
        ],
        "commands": [
          "python3 tests/smoke/run.py --target docker --fresh-volume"
        ]
      }
    },
    {
      "id": "M8",
      "name": "正式产品基线与来源闭环",
      "depends_on": ["M7"],
      "references": [
        "docs/planning/M8-implementation.md",
        "docs/planning/productization-blueprint.md",
        "docs/product/requirements.md",
        "docs/product/source-coverage.md",
        "docs/product/conflict-register.md",
        "docs/decisions/README.md",
        "docs/algorithm/model-v2.md",
        "docs/security/threat-model.md",
        "docs/releases/versioning.md"
      ],
      "acceptance": {
        "criteria": [
          "正式运行路径、根说明和发布说明统一使用报警管理系统产品身份，历史证据仍可追溯",
          "PDF/DOCX 中每项可识别能力均有实现证据、具体后续阶段、明确拒绝或外部重启条件",
          "产品化阶段、版本标签、算法研究和安全边界形成唯一可执行入口"
        ],
        "commands": [
          "python3 scripts/validate_repository.py",
          "python3 scripts/validate_automation.py",
          "python3 scripts/validate_formal_baseline.py",
          "npm --prefix tools/document-extraction run check",
          "scripts/dev/test.sh",
          "scripts/dev/restart-smoke.sh"
        ]
      }
    },
    {
      "id": "M9",
      "name": "可泛化算法模型与解释",
      "depends_on": ["M8"],
      "references": [
        "src/algorithm/README.md",
        "docs/algorithm/model-v2.md",
        "docs/product/data-contract.md",
        "docs/verification/README.md"
      ],
      "acceptance": {
        "criteria": [
          "时序专家规则的分数由输入特征和显式公式计算，不冒充概率或准确率",
          "关联链由跨 episode 的一阶 Markov 统计发现，不读取合成场景名、固定行号或步骤命名",
          "未见位号、时间平移、UUID 重映射、乱序和随机负控的泛化验收通过"
        ],
        "commands": [
          "scripts/dev/test.sh",
          "scripts/dev/m9-algorithm-v2-smoke.sh"
        ]
      }
    },
    {
      "id": "M10",
      "name": "项目化业务与全中文 UX",
      "depends_on": ["M9"],
      "references": [
        "docs/product/requirements.md",
        "docs/product/data-contract.md",
        "docs/architecture/README.md"
      ],
      "acceptance": {
        "criteria": [
          "业务人员可在浏览器创建、选择、归档项目且数据和报告按项目隔离",
          "字段映射无需编辑 JSON，业务枚举、错误、状态和操作提示完整中文化",
          "首次使用引导能完成样例导入、分析、查看、处置和报告主流程"
        ],
        "commands": [
          "scripts/dev/test.sh",
          "scripts/dev/m10-business-ux-smoke.sh"
        ]
      }
    },
    {
      "id": "M11",
      "name": "身份权限与安全部署边界",
      "depends_on": ["M10"],
      "references": [
        "docs/planning/M11-implementation.md",
        "docs/product/security-contract.md",
        "docs/security/threat-model.md",
        "docs/architecture/README.md",
        "docs/verification/README.md",
        "docs/verification/audit.md"
      ],
      "acceptance": {
        "criteria": [
          "本机模式仅绑定回环地址，网络部署要求 HTTPS 且拒绝缺失安全配置",
          "最小角色只能访问授权的项目和动作，登录、失败与关键管理动作可审计",
          "文件大小、行数、请求结构和查询输入均有限制，注入与越权负控返回明确失败"
        ],
        "commands": [
          "scripts/dev/test.sh",
          "scripts/security/m11-security-smoke.sh"
        ]
      }
    },
    {
      "id": "M12",
      "name": "恢复、质量与运行可靠性",
      "depends_on": ["M11"],
      "references": [
        "docs/verification/README.md",
        "docs/verification/automation-audit.md",
        "packaging/native/release/README.txt"
      ],
      "acceptance": {
        "criteria": [
          "备份可在隔离目标中恢复并对账，安装、停止、卸载只作用于精确发布实例",
          "格式、静态检查、依赖审计和完整回归通过且没有为通过而跳过规则",
          "重复运行无持续内存增长、端口进程残留、异常外联、乱码或不可接受的 20000 行退化"
        ],
        "commands": [
          "scripts/dev/test.sh",
          "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/native/verify-release.ps1",
          "python3 tests/reliability/run.py"
        ]
      }
    },
    {
      "id": "M13",
      "name": "正式说明书与项目过程文件",
      "depends_on": ["M12"],
      "references": [
        "docs/sources/README.md",
        "docs/product/requirements.md",
        "docs/verification/README.md"
      ],
      "acceptance": {
        "criteria": [
          "正式 README 和业务手册从先决条件到网页操作、数据库运维和故障处理均可执行",
          "立项、中期、测试、结项、过程记录和原始方案差距说明与当前代码和证据一致",
          "Markdown 单一事实源可重复生成可打开、中文正常的 DOCX 和 PDF 交付物"
        ],
        "commands": [
          "python3 tools/deliverables/build.py --check",
          "python3 scripts/validate_repository.py",
          "python3 scripts/validate_formal_baseline.py"
        ]
      }
    },
    {
      "id": "M14",
      "name": "Windows 11 业务用户终验与发布候选",
      "depends_on": ["M13"],
      "references": [
        "README.md",
        "docs/planning/M14-release-hardening.md",
        "docs/verification/README.md",
        "docs/verification/automation-audit.md"
      ],
      "acceptance": {
        "criteria": [
          "Java、Python、TypeScript/Vue 固定 lint 与构建入口通过，POM 模型和编译无未处置告警",
          "多场景样例、非法输入原子拒绝和可复现监督模型通过测试，模型参数认证加密且密钥分离",
          "Dashboard 的统计、时序、占比和表格均由当前项目数据库事实生成，主要页面通过桌面和窄屏浏览器验收",
          "背景原件及提取链不再由 Git 跟踪，正式 README、项目过程文档、部署运维手册和技术材料与实现及实测一致",
          "不了解代码的业务用户可仅按说明完成预检、安装、启动、登录、样例闭环、备份恢复和停止",
          "Windows 原生包与 HTTPS 容器部署均从干净状态通过正式验收且失败不会假成功",
          "最终差距矩阵无悬空项，阻断和严重缺陷为零，发布候选标签绑定已验证提交"
        ],
        "commands": [
          "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/release/verify-business-release.ps1",
          "python3 tests/smoke/run.py --target docker --fresh-volume",
          "python3 scripts/validate_release_candidate.py"
        ]
      }
    }
  ]
}
